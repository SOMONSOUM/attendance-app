model Event {
  id                String              @id @default(cuid())
  tenantId          String?             @map("tenant_id")
  tenant            Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  description       String?             @db.Text
  mode              EventMode
  separateQrByPlace Boolean             @default(false) @map("separate_qr_by_place")
  startsAt          DateTime            @map("starts_at")
  endsAt            DateTime            @map("ends_at")
  places            EventPlace[]
  qrCodes           EventQrCode[]
  shifts            EventShift[]
  registrations     EventRegistration[]
  attendances       Attendance[]
  theme             EventTheme?
  createdById       String?             @map("created_by_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("events")
}

model EventPlace {
  id              String              @id @default(cuid())
  eventId         String              @map("event_id")
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  catalogPlaceId  String?             @map("catalog_place_id")
  catalogPlace    Place?              @relation("EventPlaceCatalogSnapshot", fields: [catalogPlaceId], references: [id], onDelete: SetNull)
  name            String
  description     String?             @db.Text
  requireLocation Boolean             @default(false) @map("require_location")
  locationName    String?             @map("location_name") @db.Text
  latitude        Decimal?            @db.Decimal(10, 7)
  longitude       Decimal?            @db.Decimal(10, 7)
  radiusMeters    Int                 @default(0) @map("radius_meters")
  qrCodes         EventQrCode[]
  registrations   EventRegistration[]
  attendances     Attendance[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([catalogPlaceId])
  @@map("event_places")
}

model EventShift {
  id          String       @id @default(cuid())
  eventId     String       @map("event_id")
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  startTime   DateTime     @map("start_time") @db.Time(0)
  endTime     DateTime     @map("end_time") @db.Time(0)
  attendances Attendance[]
  registrations EventRegistration[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("event_shifts")
}

model EventQrCode {
  id        String      @id @default(cuid())
  code      String      @unique
  eventId   String      @map("event_id")
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId   String?     @map("place_id")
  place     EventPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  active    Boolean     @default(true)
  expiresAt DateTime?   @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([placeId])
  @@map("event_qr_codes")
}

model EventRegistration {
  id         String      @id @default(cuid())
  eventId    String      @map("event_id")
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId    String?     @map("place_id")
  place      EventPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  shiftId    String?     @map("shift_id")
  shift      EventShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  fullNameEn String      @map("full_name_en")
  fullNameKm String?     @map("full_name_km")
  gender     Gender?
  position   String?
  organization String?
  phoneNumber String?     @map("phone_number")
  checkInCode String?     @unique @map("check_in_code")
  source     String      @default("UPLOAD")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([eventId, fullNameEn])
  @@index([eventId, fullNameKm])
  @@index([phoneNumber])
  @@index([placeId])
  @@index([shiftId])
  @@map("event_registrations")
}

model EventTheme {
  eventId            String          @id @map("event_id")
  event              Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryColor       String          @default("#2563eb") @map("primary_color")
  backgroundColor    String          @default("#f8fafc") @map("background_color")
  backgroundImageUrl String?         @map("background_image_url")
  fontFamily         String          @default("Inter") @map("font_family")
  fontSize           Int             @default(16) @map("font_size")
  radius             Int             @default(8) @map("radius")
  appearance         ThemeAppearance @default(system) @map("appearance")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("event_themes")
}
