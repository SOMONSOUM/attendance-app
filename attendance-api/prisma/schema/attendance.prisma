model Attendance {
  id             String           @id @default(cuid())
  eventId        String           @map("event_id")
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId        String?          @map("place_id")
  place          EventPlace?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  userId         String?          @map("user_id")
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftId        String?          @map("shift_id")
  shift          EventShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  registrationId String?          @map("registration_id")
  fullNameEn     String           @map("full_name_en")
  fullNameKm     String?          @map("full_name_km")
  gender         Gender?
  position       String?
  organization   String?
  phoneNumber    String?          @map("phone_number")
  latitude       Decimal          @db.Decimal(10, 7)
  longitude      Decimal          @db.Decimal(10, 7)
  distanceMeters Int              @default(0) @map("distance_meters")
  status         AttendanceStatus @default(JOINED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([eventId, registrationId])
  @@index([placeId])
  @@index([shiftId])
  @@map("attendances")
}
