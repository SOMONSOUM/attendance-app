generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EventMode {
  PRE_REGISTERED
  OPEN_REGISTRATION
}

enum AttendanceStatus {
  JOINED
  CANCELLED
}

enum ThemeAppearance {
  light
  dark
  system
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  status              TenantStatus         @default(ACTIVE)
  ownerUserId         String?              @unique @map("owner_user_id")
  ownerUser           User?                @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  users               User[]
  roles               Role[]
  events              Event[]
  registrationImports RegistrationImport[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("tenants")
}

model User {
  id            String         @id @default(cuid())
  tenantId      String?        @map("tenant_id")
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedTenant   Tenant?        @relation("TenantOwner")
  email         String?        @unique
  passwordHash  String?        @map("password_hash")
  fullNameEn    String         @map("full_name_en")
  fullNameKm    String?        @map("full_name_km")
  gender        Gender?        @map("gender")
  position      String?        @map("position")
  department    String?        @map("department")
  roles         UserRole[]
  attendances   Attendance[]
  registrationImports RegistrationImport[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  tokenHash String    @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?          @map("tenant_id")
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?          @db.Text
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id        String           @id @default(cuid())
  resource  String
  action    String
  roles     RolePermission[]
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Event {
  id            String              @id @default(cuid())
  tenantId      String?             @map("tenant_id")
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  description   String?             @db.Text
  mode          EventMode
  separateQrByPlace Boolean         @default(false) @map("separate_qr_by_place")
  locationName  String              @map("location_name") @db.Text
  latitude      Decimal             @db.Decimal(10, 7)
  longitude     Decimal             @db.Decimal(10, 7)
  radiusMeters  Int                 @default(100) @map("radius_meters")
  startsAt      DateTime            @map("starts_at")
  endsAt        DateTime            @map("ends_at")
  places        EventPlace[]
  qrCodes       EventQrCode[]
  shifts        EventShift[]
  registrations EventRegistration[]
  attendances   Attendance[]
  theme         EventTheme?
  createdById   String?             @map("created_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("events")
}

model EventPlace {
  id            String              @id @default(cuid())
  eventId       String              @map("event_id")
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  description   String?             @db.Text
  locationName  String?             @map("location_name") @db.Text
  qrCodes       EventQrCode[]
  registrations EventRegistration[]
  attendances   Attendance[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("event_places")
}

model EventShift {
  id            String              @id @default(cuid())
  eventId       String              @map("event_id")
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name          String
  startTime     DateTime            @map("start_time") @db.Time(0)
  endTime       DateTime            @map("end_time") @db.Time(0)
  attendances   Attendance[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([eventId])
  @@map("event_shifts")
}

model EventQrCode {
  id        String    @id @default(cuid())
  code      String    @unique
  eventId   String    @map("event_id")
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId   String?   @map("place_id")
  place     EventPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  active    Boolean   @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([placeId])
  @@map("qr_codes")
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventId    String   @map("event_id")
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId    String?  @map("place_id")
  place      EventPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  fullNameEn String   @map("full_name_en")
  fullNameKm String?  @map("full_name_km")
  gender     Gender?
  position   String?
  department String?
  source     String   @default("UPLOAD")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([eventId, fullNameEn])
  @@index([eventId, fullNameKm])
  @@index([placeId])
  @@map("event_registrations")
}

model RegistrationImport {
  id           String                  @id @default(cuid())
  tenantId     String?                 @map("tenant_id")
  tenant       Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName     String                  @map("file_name")
  originalName String                  @map("original_name")
  rowCount     Int                     @default(0) @map("row_count")
  status       String                  @default("IMPORTED")
  uploadedById String?                 @map("uploaded_by_id")
  uploadedBy   User?                   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  rows         RegistrationImportRow[]
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([uploadedById])
  @@map("registration_imports")
}

model RegistrationImportRow {
  id         String             @id @default(cuid())
  importId   String             @map("import_id")
  import     RegistrationImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  fullNameEn String             @map("full_name_en")
  fullNameKm String?            @map("full_name_km")
  gender     Gender?
  position   String?
  department String?
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([importId, fullNameEn])
  @@map("registration_import_rows")
}

model Attendance {
  id             String           @id @default(cuid())
  eventId        String           @map("event_id")
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  placeId        String?          @map("place_id")
  place          EventPlace?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  userId         String?          @map("user_id")
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  shiftId        String?          @map("shift_id")
  shift          EventShift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  registrationId String?          @map("registration_id")
  fullNameEn     String           @map("full_name_en")
  fullNameKm     String?          @map("full_name_km")
  gender         Gender?
  position       String?
  department     String?
  latitude       Decimal          @db.Decimal(10, 7)
  longitude      Decimal          @db.Decimal(10, 7)
  distanceMeters Int              @default(0) @map("distance_meters")
  status         AttendanceStatus @default(JOINED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([eventId, registrationId])
  @@index([placeId])
  @@index([shiftId])
  @@map("attendances")
}

model EventTheme {
  eventId            String          @id @map("event_id")
  event              Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryColor       String          @default("#2563eb") @map("primary_color")
  backgroundColor    String          @default("#f8fafc") @map("background_color")
  backgroundImageUrl String?         @map("background_image_url")
  fontFamily         String          @default("Inter") @map("font_family")
  fontSize           Int             @default(16) @map("font_size")
  radius             Int             @default(8) @map("radius")
  appearance         ThemeAppearance @default(system) @map("appearance")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("event_themes")
}
