{
  "name": "attendance-platform",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @attendance/api prisma:generate",
    "db:migrate": "pnpm --filter @attendance/api prisma:migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
